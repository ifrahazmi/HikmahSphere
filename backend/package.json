{
  "name": "hikmahsphere-backend",
  "version": "1.0.0",
  "description": "Backend API for HikmahSphere - Modern Islamic Digital Platform. RESTful API with Prayer Times, Quran, Zakat Calculator, Authentication & Community Features. Built with Node.js + TypeScript + MongoDB.",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "cp package.json dist/ && mkdir -p dist/assets/hajj-guide && cp src/assets/hajj-guide/* dist/assets/hajj-guide/ && mkdir -p dist/data && cp src/data/indopak-nastaleeq-v3.db dist/data/",
    "docker:build": "docker build -t hikmahsphere-backend .",
    "docker:run": "docker run -p 5000:5000 hikmahsphere-backend",
    "debug:notifications": "tsx src/utils/debug_notifications.ts",
    "seed-questions": "tsx src/scripts/seed-questions.ts",
    "verify-questions": "tsx src/scripts/verify-questions.ts",
    "migrate:zakat-purpose": "tsx src/scripts/migrate-zakat-purpose.ts"
  },
  "keywords": [
    "islam",
    "muslim",
    "api",
    "nodejs",
    "express",
    "revolutionary"
  ],
  "author": "HikmahSphere Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/redis": "^4.0.10",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.24.4",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "nodemon": "^3.1.10",
    "redis": "^5.10.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  },
  "overrides": {
    "eslint": "^8.57.1",
    "brace-expansion": "1.1.18",
    "minimatch": "3.1.5",
    "esbuild": "0.28.2"
  },
  "jest": {
    "preset": "ts-jest",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "ignore": [
      "src/**/*.spec.ts"
    ],
    "exec": "tsx src/index.ts"
  }
}
