# 🕌 HikmahSphere Environment Configuration

# ==================== Application ====================
NODE_ENV=development
APP_NAME=HikmahSphere

# ==================== Server Ports ====================
BACKEND_PORT=5000
FRONTEND_PORT=3000
PORT=5000

# ==================== MongoDB Configuration ====================
# For development on VM - ensure MongoDB is running on localhost:27017
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGODB_URI=mongodb://admin:password123@localhost:27017/hikmahsphere?authSource=admin

# ==================== JWT Authentication ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this_12345
REFRESH_TOKEN_EXPIRE=7d

# ==================== Redis Configuration ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== Cache Configuration ====================
PRAYER_TIMES_CACHE_TTL=15
FASTING_TIMES_CACHE_TTL=15
RAMADAN_TIMES_CACHE_TTL=60
WEATHER_CACHE_TTL=30
CORS_ORIGIN=http://localhost:3000

# ==================== Frontend Configuration ====================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENVIRONMENT=development
REACT_APP_FIREBASE_VAPID_KEY=enter_your_api_key_here

# ==================== Email Configuration (Optional) ====================
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=ifrahazmi@hikmahsphere.site
SMTP_PASS=YOUR_PASSWORD_HERE
SMTP_FROM=noreply@hikmahsphere.com

# ==================== Islamic API ====================
ISLAMIC_API_KEY=your_islamic_api_key_here
