# 🕌 HikmahSphere Environment Configuration
# Copy this file to `.env` (and/or `backend/.env`) and fill in values.
# NEVER commit real secrets.

# ==================== Application ====================
NODE_ENV=development
APP_NAME=HikmahSphere
FRONTEND_URL=http://localhost:3000

# ==================== Server Ports ====================
BACKEND_PORT=5000
FRONTEND_PORT=3000
PORT=5000

# ==================== MongoDB ====================
# Single connection string for local Docker Mongo AND production Atlas.
# Database name in the URI path must remain: hikmahsphere
#
# Leave empty here and set in your real `.env` / Render dashboard:
MONGODB_URI=
#
# Local examples (do not commit real credentials):
#   Docker Compose (backend container → mongodb service):
#     MONGODB_URI=mongodb://admin:password123@mongodb:27017/hikmahsphere?authSource=admin
#   Host process → published Docker port:
#     MONGODB_URI=mongodb://admin:password123@localhost:27017/hikmahsphere?authSource=admin
#
# Production (MongoDB Atlas) — set on Render only:
#   Include the database name in the path (`/hikmahsphere`).
#   Also allow the Render (and local test) IPs in Atlas Network Access.
#   MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/hikmahsphere?retryWrites=true&w=majority
#   If the password has special characters, URL-encode them in the Atlas connection string.
#
# Optional local-only override (takes precedence over MONGODB_URI when set):
# MONGODB_URI_LOCAL=
#
# Docker Compose init credentials (local Mongo container only — not used by Atlas):
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
# Optional mongoose auth overrides (ignored when MONGODB_URI already embeds user:pass@):
# MONGO_USER=
# MONGO_PASS=

# ==================== JWT Authentication ====================
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_string
REFRESH_TOKEN_EXPIRE=7d

# ==================== Redis ====================
# Local Docker / host Redis (used when REDIS_URL is unset):
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Production (Upstash TLS Redis URL). Takes precedence over HOST/PORT.
# Copy the Redis URL from the Upstash console (rediss://...). Set on Render.
# Leave empty for local Docker Redis.
REDIS_URL=

# ==================== CORS ====================
# Comma-separated browser origins allowed to call the API.
# Local:
CORS_ORIGIN=http://localhost:3000
# Production examples (set on Render):
# CORS_ORIGIN=https://hikmahsphere.site,https://www.hikmahsphere.site,https://your-app.vercel.app

# ==================== Uploads (Cloudflare R2) ====================
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=hikmahsphere-uploads
R2_PRIVATE_BUCKET=hikmahsphere-private
R2_PUBLIC_URL=https://pub-YOUR_ID.r2.dev
# Legacy local files remain readable from this optional path.
# UPLOADS_DIR=

# ==================== Tafsir / Maududi upstream ====================
# Backend proxies Bayan (and Tafheem when MAUDUDI_API_URL is set).
# These must be reachable FROM the Render backend (not from the browser).
TAFSIR_API_URL=https://aws-vm.reedfish-temperature.ts.net/api
# Optional override. If unset, backend uses the existing AWS/Tailscale Maududi service.
# MAUDUDI_API_URL=https://aws-vm.reedfish-temperature.ts.net/api/maududi
# TAFHEEM_FIXTURE_PATH=

# ==================== Cache TTLs (minutes) ====================
PRAYER_TIMES_CACHE_TTL=15
FASTING_TIMES_CACHE_TTL=15
RAMADAN_TIMES_CACHE_TTL=60
WEATHER_CACHE_TTL=30
PRAYER_TIMES_REFRESH_INTERVAL=15

# ==================== Frontend (CRA — also set in Vercel project settings) ====================
# Local (CRA proxy): leave empty or use /api
REACT_APP_API_URL=
# Production (Vercel build-time):
# REACT_APP_API_URL=https://your-backend.onrender.com/api
REACT_APP_ENVIRONMENT=development
# Required for browser/PWA push and baked into the Vercel build at deploy time.
REACT_APP_FIREBASE_VAPID_KEY=
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_PRAYER_TIMES_CACHE_TTL=15
# Optional overrides (normally leave unset — frontend uses backend proxy):
# REACT_APP_TAFSIR_API_URL=
# REACT_APP_MAUDUDI_API_URL=

# ==================== Email (Zoho HTTPS API) ====================
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM=info@hikmahsphere.site
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_MAIL_API_URL=https://mail.zoho.in
# Optional inbox for contact/newsletter (defaults to ZOHO_FROM)
# SMTP_TO=info@hikmahsphere.site

# ==================== Admin seed (first boot) ====================
ADMIN_EMAIL=admin@hikmah.com
ADMIN_PASSWORD=change_me

# ==================== External APIs ====================
ISLAMIC_API_KEY=

# ==================== Firebase Admin (required for push on Render) ====================
# Full service-account JSON from the same Firebase project as the frontend.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ==================== Security / rate limits ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# ==================== Logging (all optional, safe defaults) ====================
# Successful requests slower than this get a full multi-line log block
LOG_SLOW_REQUEST_MS=1500
# Maximum characters of a request body printed in a log block
LOG_BODY_MAX_CHARS=600
# Detail lines collapse to one-liners above this rate (Render drops above 6000/min)
LOG_MAX_LINES_PER_MINUTE=2000
