# Frontend (CRA) — copy to frontend/.env for local overrides.
# Production values must be set in the Vercel project (build-time).

# Backend API base including /api suffix.
# Local: leave unset to use /api via the CRA proxy to :5000.
# Vercel: set this value for Production, Preview, and Development.
# The app also uses this Render URL as its production fallback.
# REACT_APP_API_URL=https://hikmahsphere-backend.onrender.com/api
REACT_APP_API_URL=

# Google Maps (Mosque Finder) — public browser key with HTTP referrer restrictions
REACT_APP_GOOGLE_MAPS_API_KEY=

# Required for web push. Copy the Web Push certificate public key from
# Firebase Console -> Project Settings -> Cloud Messaging, then redeploy Vercel.
REACT_APP_FIREBASE_VAPID_KEY=

# Prayer times client cache duration (minutes) — should match backend PRAYER_TIMES_CACHE_TTL
REACT_APP_PRAYER_TIMES_CACHE_TTL=15

# Local only: a tafsir process on this machine. Leave unset to use /api/quran/tafsir.
# On Vercel leave these unset. Render should have TAFSIR_API_URL and MAUDUDI_API_URL instead.
# REACT_APP_TAFSIR_API_URL=http://localhost:9000/api
# REACT_APP_MAUDUDI_API_URL=http://localhost:9000/api/maududi
